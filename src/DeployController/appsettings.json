    "GitTimeoutSeconds": 900,
    "DockerBuildTimeoutSeconds": 3600,
    "DockerQuickTimeoutSeconds": 180,
    "MaxJobHistory": 50,
    "MaxLogLinesPerJob": 20000,
    "PublicHost": null
  }
}
